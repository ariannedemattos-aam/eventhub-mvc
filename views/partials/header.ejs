<!DOCTYPE html>

<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= titulo ? `${titulo} | EventHub` : 'EventHub' %></title>

  <link rel="stylesheet" href="/css/style.css">

</head>

<body>

  <header>

    <div class="container navbar">

      <a href="/eventos" class="logo">
  <img src="/imagens/logo.png" alt="Logo EventHub">
  <span>EventHub</span>
     </a>

      <nav>

        <ul class="nav-links">

          <li>
            <a href="/eventos">Eventos</a>
          </li>

          <% if (usuario) { %>

            <% if (usuario.tipo === 'organizador') { %>

              <li>
                <a href="/eventos/novo">Criar evento</a>
              </li>

            <% } %>

            <% if (usuario.tipo === 'participante') { %>

              <li>
                <a href="/minhas-inscricoes">Minhas inscrições</a>
              </li>

            <% } %>

            <li>
              <span>
                Olá, <strong><%= usuario.nome %></strong>
              </span>
            </li>

            <li>

              <form action="/logout" method="POST">

                <button type="submit" class="btn btn-secondary">
                  Sair
                </button>

              </form>

            </li>

          <% } else { %>

            <li>
              <a href="/login">Entrar</a>
            </li>

            <li>

              <a href="/cadastro" class="btn btn-primary">
                Criar conta
              </a>

            </li>

          <% } %>

        </ul>

      </nav>

    </div>

  </header>

  <main>

    <div class="container">