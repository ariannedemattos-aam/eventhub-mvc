<%- include('../partials/header') %>

<section class="page-header">
  <h1>Meus eventos</h1>

  <p>
    Gerencie os eventos que você publica no EventHub.
  </p>
</section>

<div class="actions mb-3">
  <a
    href="/eventos/novo"
    class="btn btn-primary"
  >
    Criar novo evento
  </a>
</div>

<section>
  <div class="section-header">
    <h2>Próximos eventos</h2>
  </div>

  <% if (proximos && proximos.length > 0) { %>
    <div class="eventos-grid">
      <% proximos.forEach((evento) => { %>
        <%- include('../partials/evento-card', {
          evento,
          exibirEdicao: true
        }) %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h2>Nenhum evento futuro</h2>

      <p>
        Você não possui eventos futuros publicados.
      </p>

      <a
        href="/eventos/novo"
        class="btn btn-primary"
      >
        Criar evento
      </a>
    </div>
  <% } %>
</section>

<% if (anteriores && anteriores.length > 0) { %>
  <section>
    <div class="section-header">
      <h2>Eventos anteriores</h2>
    </div>

    <div class="eventos-grid">
      <% anteriores.forEach((evento) => { %>
        <%- include('../partials/evento-card', {
          evento,
          exibirEdicao: true
        }) %>
      <% }) %>
    </div>
  </section>
<% } %>

<%- include('../partials/footer') %>