<%- include('../partials/header') %>

<section class="page-header">
  <h1><%= evento.titulo %></h1>
  <p>Confira os detalhes deste evento.</p>
</section>

<div class="card">

  <div class="details-list">

    <div class="details-item">
      <strong>Data:</strong>
      <%= new Date(evento.data).toLocaleDateString('pt-BR') %>
    </div>

    <div class="details-item">
      <strong>Local:</strong>
      <%= evento.local %>
    </div>

    <div class="details-item">
      <strong>Organizador:</strong>
      <%= evento.organizador_nome %>
    </div>

  </div>

  <div style="margin: 25px 0;">
    <h2>Sobre o evento</h2>

    <p style="margin-top: 10px;">
      <%= evento.descricao %>
    </p>
  </div>

  <% if (usuario && usuario.id === evento.organizador_id) { %>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">

      <a
        href="/eventos/<%= evento.id %>/editar"
        class="btn btn-secondary"
      >
        Editar evento
      </a>

      <form
        action="/eventos/<%= evento.id %>/excluir"
        method="POST"
        data-confirmacao="Tem certeza que deseja excluir este evento?"
      >
        <button type="submit" class="btn btn-danger">
          Excluir evento
        </button>
      </form>

    </div>

  <% } %>

  <% if (usuario && usuario.id !== evento.organizador_id) { %>

    <form
      action="/eventos/<%= evento.id %>/inscrever"
      method="POST"
      style="margin-top: 20px;"
    >
      <button type="submit" class="btn btn-primary">
        Quero participar
      </button>
    </form>

  <% } %>

  <% if (!usuario) { %>

    <div style="margin-top: 20px;">

      <p>
        Faça login para se inscrever neste evento.
      </p>

      <a
        href="/login"
        class="btn btn-primary"
        style="margin-top: 10px;"
      >
        Entrar
      </a>

    </div>

  <% } %>

</div>

<%- include('../partials/footer') %>