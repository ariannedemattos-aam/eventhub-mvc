<%- include('../partials/header') %>

<%
  const hoje = new Date();
  hoje.setHours(0, 0, 0, 0);

  const dataEvento = new Date(evento.data);
  dataEvento.setHours(0, 0, 0, 0);

  const encerrado = dataEvento < hoje;

  const esgotado =
    evento.tipo_ingresso === 'gratuito' &&
    evento.vagas !== null &&
    Number(evento.vagas_restantes) <= 0;
%>

<section class="page-header">
  <h1><%= evento.titulo %></h1>

  <div class="badges">
    <span class="badge badge-categoria">
      <%= evento.categoria_nome %>
    </span>

    <% if (evento.tipo_ingresso === 'gratuito') { %>
      <span class="badge badge-gratuito">
        Gratuito
      </span>
    <% } else { %>
      <span class="badge badge-pago">
        Pago
      </span>
    <% } %>

    <% if (encerrado) { %>
      <span class="badge badge-encerrado">
        Encerrado
      </span>
    <% } else if (esgotado) { %>
      <span class="badge badge-esgotado">
        Esgotado
      </span>
    <% } else if (evento.tipo_ingresso === 'gratuito') { %>
      <span class="badge badge-aberto">
        Inscrições abertas
      </span>
    <% } else { %>
      <span class="badge badge-em-breve">
        Em breve
      </span>
    <% } %>
  </div>
</section>

<% if (
  typeof interesseStatus !== 'undefined' &&
  interesseStatus === 'adicionado'
) { %>
  <div class="alert alert-success">
    ✨ Interesse adicionado! Agora você verá mais eventos de
    <strong><%= evento.categoria_nome %></strong> no Para você.
  </div>
<% } else if (
  typeof interesseStatus !== 'undefined' &&
  interesseStatus === 'ja-existe'
) { %>
  <div class="alert alert-info">
    ✨ <strong><%= evento.categoria_nome %></strong>
    já faz parte dos seus interesses.
  </div>
<% } %>

<div class="card">
  <% if (evento.imagem_url) { %>
    <img
      src="<%= evento.imagem_url %>"
      alt="Capa do evento <%= evento.titulo %>"
      class="evento-detalhe-imagem"
    >
  <% } %>

  <div class="details-list">
    <div class="details-item">
      <strong>Data:</strong>
      <%= new Date(evento.data).toLocaleDateString(
        'pt-BR',
        { timeZone: 'UTC' }
      ) %>
    </div>

    <div class="details-item">
      <strong>Local:</strong>
      <%= evento.local %>
    </div>

    <div class="details-item">
      <strong>Organizador:</strong>
      <a
        href="/usuarios/<%= evento.organizador_id %>"
        class="organizador-link"
      >
        <%= evento.organizador_nome %>
      </a>
    </div>

    <% if (evento.tipo_ingresso === 'gratuito') { %>
      <div class="details-item">
        <strong>Inscrições:</strong>
        <%= evento.total_inscritos %>

        <% if (evento.vagas !== null) { %>
          de <%= evento.vagas %>
        <% } %>
      </div>

      <% if (evento.vagas !== null) { %>
        <div class="details-item">
          <strong>Vagas restantes:</strong>
          <%= evento.vagas_restantes %>
        </div>
      <% } %>
    <% } %>

    <% if (evento.tipo_ingresso === 'pago') { %>
      <div class="details-item">
        <strong>Preço:</strong>
        <%= Number(evento.preco).toLocaleString(
          'pt-BR',
          {
            style: 'currency',
            currency: 'BRL'
          }
        ) %>
      </div>

      <% if (
        evento.vagas !== null &&
        evento.vagas !== undefined
      ) { %>
        <div class="details-item">
          <strong>Vagas:</strong>
          <%= evento.vagas %>
        </div>
      <% } %>
    <% } %>
  </div>

  <div class="evento-descricao">
    <h2>Sobre o evento</h2>

    <p class="mt-1">
      <%= evento.descricao %>
    </p>
  </div>

  <% if (evento.cupom) { %>
    <div class="alert alert-info">
      <strong>Cupom ou benefício:</strong>
      <%= evento.cupom %>
    </div>
  <% } %>

  <% if (
    usuario &&
    usuario.id === evento.organizador_id
  ) { %>
    <div class="actions">
      <a
        href="/eventos/<%= evento.id %>/editar"
        class="btn btn-secondary"
      >
        Editar evento
      </a>

      <form
        action="/eventos/<%= evento.id %>/excluir"
        method="POST"
        data-confirmacao="Tem certeza que deseja excluir este evento?"
      >
        <button
          type="submit"
          class="btn btn-danger"
        >
          Excluir evento
        </button>
      </form>
    </div>
  <% } else { %>

    <% if (usuario) { %>
      <div class="actions mb-2">
        <% if (favoritado) { %>
          <form
            action="/eventos/<%= evento.id %>/desfavoritar"
            method="POST"
          >
            <button
              type="submit"
              class="btn btn-secondary"
            >
              ♥ Remover dos favoritos
            </button>
          </form>
        <% } else { %>
          <form
            action="/eventos/<%= evento.id %>/favoritar"
            method="POST"
          >
            <button
              type="submit"
              class="btn btn-outline"
            >
              ♡ Favoritar
            </button>
          </form>
        <% } %>

        <form
          action="/eventos/<%= evento.id %>/quero-mais"
          method="POST"
        >
          <button
            type="submit"
            class="btn btn-outline"
          >
            ✨ Quero mais como este
          </button>
        </form>
      </div>
    <% } %>

    <% if (!encerrado) { %>

      <% if (evento.tipo_ingresso === 'gratuito') { %>

        <% if (!esgotado) { %>

          <% if (usuario) { %>
            <form
              action="/eventos/<%= evento.id %>/inscrever"
              method="POST"
            >
              <button
                type="submit"
                class="btn btn-primary"
              >
                Quero participar
              </button>
            </form>
          <% } else { %>
            <div class="alert alert-info">
              <p>
                Entre na sua conta para se inscrever gratuitamente.
              </p>

              <a
                href="/login"
                class="btn btn-primary mt-1"
              >
                Entrar
              </a>
            </div>
          <% } %>

        <% } else { %>
          <div class="alert alert-error">
            Este evento está sem vagas disponíveis.
          </div>
        <% } %>

      <% } else if (evento.link_ingresso) { %>
        <a
          href="<%= evento.link_ingresso %>"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Comprar ingresso
        </a>

        <p class="form-help mt-1">
          A compra acontece em uma plataforma externa.
        </p>
      <% } %>

    <% } else { %>
      <div class="alert alert-info">
        Este evento já aconteceu.
      </div>
    <% } %>

  <% } %>
</div>

<%- include('../partials/footer') %>