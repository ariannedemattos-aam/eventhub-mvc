<%- include('../partials/header') %>

<section class="page-header">
  <h1>Editar evento</h1>
  <p>Atualize as informações do seu evento.</p>
</section>

<div class="form-container">

  <% if (erros && erros.length > 0) { %>

    <div class="alert alert-error">

      <% erros.forEach((erro) => { %>
        <p><%= erro.msg %></p>
      <% }) %>

    </div>

  <% } %>

  <form action="/eventos/<%= evento.id %>/editar" method="POST">

    <div class="form-group">
      <label for="titulo">Título</label>

      <input
        type="text"
        id="titulo"
        name="titulo"
        class="form-control"
        value="<%= evento.titulo %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="descricao">Descrição</label>

      <textarea
        id="descricao"
        name="descricao"
        class="form-control"
        required
      ><%= evento.descricao %></textarea>
    </div>

    <div class="form-group">
      <label for="data">Data</label>

      <input
        type="date"
        id="data"
        name="data"
        class="form-control"
        value="<%= new Date(evento.data).toISOString().split('T')[0] %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="local">Local</label>

      <input
        type="text"
        id="local"
        name="local"
        class="form-control"
        value="<%= evento.local %>"
        required
      >
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">

      <button type="submit" class="btn btn-primary">
        Salvar alterações
      </button>

      <a
        href="/eventos/<%= evento.id %>"
        class="btn btn-secondary"
      >
        Cancelar
      </a>

    </div>

  </form>

</div>

<%- include('../partials/footer') %>