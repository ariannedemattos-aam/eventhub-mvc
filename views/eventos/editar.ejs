<%- include('../partials/header') %>

<section class="page-header">
  <h1>Editar evento</h1>
  <p>Atualize as informações publicadas no EventHub.</p>
</section>

<div class="form-container">
  <% if (erros && erros.length > 0) { %>
    <div class="alert alert-error">
      <% erros.forEach((erro) => { %>
        <p><%= erro.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form
    action="/eventos/<%= evento.id %>/editar"
    method="POST"
    enctype="multipart/form-data"
  >
    <div class="form-group">
      <label for="titulo">Título</label>
      <input
        type="text"
        id="titulo"
        name="titulo"
        class="form-control"
        value="<%= evento.titulo %>"
        minlength="3"
        maxlength="150"
        required
      >
    </div>

    <div class="form-group">
      <label for="descricao">Descrição</label>
      <textarea
        id="descricao"
        name="descricao"
        class="form-control"
        minlength="10"
        maxlength="2000"
        required
      ><%= evento.descricao %></textarea>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="data">Data</label>
        <input
          type="date"
          id="data"
          name="data"
          class="form-control"
          value="<%= new Date(evento.data).toISOString().split('T')[0] %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="categoria_id">Categoria</label>
        <select
          id="categoria_id"
          name="categoria_id"
          class="form-control"
          required
        >
          <% categorias.forEach((categoria) => { %>
            <option
              value="<%= categoria.id %>"
              <%= String(evento.categoria_id) === String(categoria.id)
                ? 'selected'
                : '' %>
            >
              <%= categoria.nome %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group form-group-full">
        <label for="local">Local</label>
        <input
          type="text"
          id="local"
          name="local"
          class="form-control"
          value="<%= evento.local %>"
          maxlength="150"
          required
        >
      </div>

      <div class="form-group form-group-full">
        <label for="imagem">
          Nova imagem de capa do dispositivo
        </label>
        <input
          type="file"
          id="imagem"
          name="imagem"
          class="form-control"
          accept="image/jpeg,image/png,image/webp"
        >
      </div>

      <div class="form-group form-group-full">
        <label for="imagem_url">
          Ou use uma URL de imagem
        </label>
        <input
          type="url"
          id="imagem_url"
          name="imagem_url"
          class="form-control"
          value="<%= evento.imagem_url || '' %>"
        >
      </div>

      <div class="form-group">
        <label for="tipo_ingresso">
          Tipo de ingresso
        </label>
        <select
          id="tipo_ingresso"
          name="tipo_ingresso"
          class="form-control"
          required
        >
          <option
            value="gratuito"
            <%= evento.tipo_ingresso === 'gratuito'
              ? 'selected'
              : '' %>
          >
            Gratuito
          </option>

          <option
            value="pago"
            <%= evento.tipo_ingresso === 'pago'
              ? 'selected'
              : '' %>
          >
            Pago
          </option>
        </select>
      </div>

      <div class="form-group">
        <label for="vagas">Vagas</label>
        <input
          type="number"
          id="vagas"
          name="vagas"
          class="form-control"
          min="1"
          placeholder="Opcional"
          value="<%= evento.vagas || '' %>"
        >
        <small class="form-help">
          Deixe vazio caso não queira informar um limite de vagas.
        </small>
      </div>

      <div
        class="form-group campo-condicional"
        data-ingresso="pago"
      >
        <label for="preco">Preço</label>
        <input
          type="number"
          id="preco"
          name="preco"
          class="form-control"
          min="0"
          step="0.01"
          value="<%= evento.preco !== null &&
                    evento.preco !== undefined
                      ? evento.preco
                      : '' %>"
        >
      </div>

      <div
        class="form-group campo-condicional"
        data-ingresso="pago"
      >
        <label for="cupom">
          Cupom ou benefício
        </label>
        <input
          type="text"
          id="cupom"
          name="cupom"
          class="form-control"
          maxlength="50"
          value="<%= evento.cupom || '' %>"
          placeholder="Opcional"
        >
      </div>

      <div
        class="form-group form-group-full campo-condicional"
        data-ingresso="pago"
      >
        <label for="link_ingresso">
          Link para compra
        </label>
        <input
          type="url"
          id="link_ingresso"
          name="link_ingresso"
          class="form-control"
          maxlength="1000"
          value="<%= evento.link_ingresso || '' %>"
        >
      </div>
    </div>

    <div class="actions mt-3">
      <button
        type="submit"
        class="btn btn-primary"
      >
        Salvar alterações
      </button>

      <a
        href="/eventos/<%= evento.id %>"
        class="btn btn-secondary"
      >
        Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>