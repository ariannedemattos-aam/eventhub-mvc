<%- include('../partials/header') %>

<section class="page-header">
  <h1>Criar evento</h1>
  <p>
    Publique um evento e conecte-se com pessoas interessadas.
  </p>
</section>

<div class="form-container">
  <% if (erros && erros.length > 0) { %>
    <div class="alert alert-error">
      <% erros.forEach((erro) => { %>
        <p><%= erro.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form
    action="/eventos"
    method="POST"
    enctype="multipart/form-data"
  >
    <div class="form-group">
      <label for="titulo">Título</label>
      <input
        type="text"
        id="titulo"
        name="titulo"
        class="form-control"
        value="<%= dados && dados.titulo ? dados.titulo : '' %>"
        minlength="3"
        maxlength="150"
        required
      >
    </div>

    <div class="form-group">
      <label for="descricao">Descrição</label>
      <textarea
        id="descricao"
        name="descricao"
        class="form-control"
        minlength="10"
        maxlength="2000"
        required
      ><%= dados && dados.descricao ? dados.descricao : '' %></textarea>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="data">Data</label>
        <input
          type="date"
          id="data"
          name="data"
          class="form-control"
          value="<%= dados && dados.data ? dados.data : '' %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="categoria_id">Categoria</label>
        <select
          id="categoria_id"
          name="categoria_id"
          class="form-control"
          required
        >
          <option value="">Selecione uma categoria</option>

          <% categorias.forEach((categoria) => { %>
            <option
              value="<%= categoria.id %>"
              <%= dados &&
                  String(dados.categoria_id) === String(categoria.id)
                    ? 'selected'
                    : '' %>
            >
              <%= categoria.nome %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group form-group-full">
        <label for="local">Local</label>
        <input
          type="text"
          id="local"
          name="local"
          class="form-control"
          value="<%= dados && dados.local ? dados.local : '' %>"
          maxlength="150"
          required
        >
      </div>

      <div class="form-group form-group-full">
        <label for="imagem">
          Imagem de capa do dispositivo
        </label>
        <input
          type="file"
          id="imagem"
          name="imagem"
          class="form-control"
          accept="image/jpeg,image/png,image/webp"
        >
        <small class="form-help">
          JPG, PNG ou WEBP. Tamanho máximo: 5 MB.
        </small>
      </div>

      <div class="form-group form-group-full">
        <label for="imagem_url">
          Ou use uma URL de imagem
        </label>
        <input
          type="url"
          id="imagem_url"
          name="imagem_url"
          class="form-control"
          value="<%= dados && dados.imagem_url ? dados.imagem_url : '' %>"
          placeholder="https://exemplo.com/imagem.jpg"
        >
      </div>

      <div class="form-group">
        <label for="tipo_ingresso">
          Tipo de ingresso
        </label>
        <select
          id="tipo_ingresso"
          name="tipo_ingresso"
          class="form-control"
          required
        >
          <option
            value="gratuito"
            <%= !dados ||
                !dados.tipo_ingresso ||
                dados.tipo_ingresso === 'gratuito'
                  ? 'selected'
                  : '' %>
          >
            Gratuito
          </option>

          <option
            value="pago"
            <%= dados &&
                dados.tipo_ingresso === 'pago'
                  ? 'selected'
                  : '' %>
          >
            Pago
          </option>
        </select>
      </div>

      <div class="form-group">
        <label for="vagas">Vagas</label>
        <input
          type="number"
          id="vagas"
          name="vagas"
          class="form-control"
          min="1"
          placeholder="Opcional"
          value="<%= dados && dados.vagas ? dados.vagas : '' %>"
        >
        <small class="form-help">
          Deixe vazio caso não queira informar um limite de vagas.
        </small>
      </div>

      <div
        class="form-group campo-condicional"
        data-ingresso="pago"
      >
        <label for="preco">Preço</label>
        <input
          type="number"
          id="preco"
          name="preco"
          class="form-control"
          min="0"
          step="0.01"
          value="<%= dados && dados.preco ? dados.preco : '' %>"
        >
      </div>

      <div
        class="form-group campo-condicional"
        data-ingresso="pago"
      >
        <label for="cupom">
          Cupom ou benefício
        </label>
        <input
          type="text"
          id="cupom"
          name="cupom"
          class="form-control"
          maxlength="50"
          placeholder="Opcional"
          value="<%= dados && dados.cupom ? dados.cupom : '' %>"
        >
      </div>

      <div
        class="form-group form-group-full campo-condicional"
        data-ingresso="pago"
      >
        <label for="link_ingresso">
          Link para compra
        </label>
        <input
          type="url"
          id="link_ingresso"
          name="link_ingresso"
          class="form-control"
          maxlength="1000"
          value="<%= dados && dados.link_ingresso ? dados.link_ingresso : '' %>"
          placeholder="https://..."
        >
        <small class="form-help">
          A compra acontece em uma plataforma externa.
          O EventHub não processa pagamentos.
        </small>
      </div>
    </div>

    <div class="actions mt-3">
      <button
        type="submit"
        class="btn btn-primary"
      >
        Publicar evento
      </button>

      <a
        href="/eventos"
        class="btn btn-secondary"
      >
        Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>