<%- include('../partials/header') %>

<section class="auth-page">
  <div class="auth-card">

    <h1>Crie sua conta</h1>
    <p class="subtitle">
      Faça parte do EventHub e encontre ou organize eventos. 💜
    </p>

    <% if (erros && erros.length > 0) { %>
      <div class="alert alert-error">

        <% erros.forEach((erro) => { %>
          <p><%= erro.msg %></p>
        <% }) %>

      </div>
    <% } %>

    <form action="/cadastro" method="POST">

      <div class="form-group">
        <label for="nome">Nome</label>

        <input
          type="text"
          id="nome"
          name="nome"
          class="form-control"
          placeholder="Seu nome"
          value="<%= dados && dados.nome ? dados.nome : '' %>"
          required
          autocomplete="name"
        >
      </div>

      <div class="form-group">
        <label for="email">E-mail</label>

        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          placeholder="seuemail@exemplo.com"
          value="<%= dados && dados.email ? dados.email : '' %>"
          required
          autocomplete="email"
        >
      </div>

      <div class="form-group">
        <label for="senha">Senha</label>

        <input
          type="password"
          id="senha"
          name="senha"
          class="form-control"
          placeholder="Mínimo de 6 caracteres"
          minlength="6"
          required
          autocomplete="new-password"
        >
      </div>

      <div class="form-group">
        <label for="tipo">Quero usar o EventHub como:</label>

        <select
          id="tipo"
          name="tipo"
          class="form-control"
          required
        >
          <option value="">Selecione uma opção</option>

          <option
            value="participante"
            <%= dados && dados.tipo === 'participante' ? 'selected' : '' %>
          >
            Participante
          </option>

          <option
            value="organizador"
            <%= dados && dados.tipo === 'organizador' ? 'selected' : '' %>
          >
            Organizador
          </option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">
        Criar minha conta
      </button>

    </form>

    <p class="subtitle" style="margin-top: 20px; margin-bottom: 0;">
      Já possui uma conta?
      <a href="/login">Entrar</a>
    </p>

  </div>
</section>

<%- include('../partials/footer') %>